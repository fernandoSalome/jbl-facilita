generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  proposals    Proposal[]    @relation("createdBy")
  agenda       AgendaConfig?
  compromissos Compromisso[]
}

/// Um projeto é um loteamento (a "subconta"). Tudo do loteamento pendura aqui:
/// propostas hoje; documentos, licenças, tarefas e o grupo de WhatsApp depois.
model Project {
  id            String            @id @default(cuid())
  name          String
  tipo          String            @default("Loteamento aberto")
  municipio     String
  uf            String            @default("SP")
  matricula     String?
  areaTotal     Float
  /// URL pública (/demo/...) ou data URL da foto aérea
  aerialImage   String?
  /// prospeccao | proposta | parceria | aprovacao | obras | vendas | carteira | arquivado
  fase          String            @default("prospeccao")
  /// contrato da SPE assinado: só então o loteamento vira Projeto e aparece no seletor (pedido 20/11/2026)
  speAssinadaEm DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  proposals     Proposal[]
  documents     ProjectDocument[]
}

model Template {
  id             String           @id @default(cuid())
  /// Chave do componente que renderiza o template ("jbl-padrao")
  key            String?
  name           String
  description    String?
  /// ativo | em_preparacao
  status         String           @default("ativo")
  sourceFileName String?
  sourceFile     Bytes?
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  proposals      Proposal[]
  versions       FormatoVersion[]
}

/// Conteúdo de um formato (loteamento aberto, condomínio...) dentro de um template:
/// listas de obras e benfeitorias, padrões e textos. Cada "Salvar" do template cria
/// uma versão nova. "Só nas próximas" deixa as propostas antigas na versão anterior.
model FormatoVersion {
  id          String     @id @default(cuid())
  templateId  String
  template    Template   @relation(fields: [templateId], references: [id])
  formato     String
  content     Json
  createdById String?
  createdAt   DateTime   @default(now())
  proposals   Proposal[]

  @@index([templateId, formato])
}

model Proposal {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id])
  templateId       String
  template         Template        @relation(fields: [templateId], references: [id])
  /// loteamento_aberto | condominio_urbano | chacreamento_aberto | chacreamento_condominio
  formato          String          @default("loteamento_aberto")
  /// Versão do formato que a proposta usa (texto, listas). Ajustes da proposta ficam em overrides.
  formatoVersionId String?
  formatoVersion   FormatoVersion? @relation(fields: [formatoVersionId], references: [id])
  name             String
  ownerName        String
  ownerPhone       String?
  /// Entradas do estudo (StudyInputs). Os resultados são recalculados a partir delas.
  inputs           Json
  /// cartaIntencao, validadeDias, corretor...
  options          Json            @default("{}")
  /// Valores e textos alterados à mão na proposta: { chave: texto }
  overrides        Json            @default("{}")
  /// rascunho | enviada | aberta | carta_recebida | negociacao | aceita | recusada
  status           String          @default("rascunho")
  publicToken      String          @unique
  publishedAt      DateTime?
  expiresAt        DateTime?
  /// PDF gerado da proposta: arquivo, número de páginas e a "assinatura" do conteúdo que o gerou
  pdfData          Bytes?
  pdfPages         Int?
  pdfKey           String?
  /// Bloqueada para edição: só visualização (nada dela muda até liberar). Quem bloqueou
  lockedAt         DateTime?
  lockedBy         String?
  /// Fixada no topo da lista de propostas (vazio = não fixada)
  pinnedAt         DateTime?
  viewCount        Int             @default(0)
  firstViewedAt    DateTime?
  lastViewedAt     DateTime?
  createdById      String?
  createdBy        User?           @relation("createdBy", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  /// Exclusão lógica: nunca apaga, só esconde. Admin pode reativar.
  deletedAt        DateTime?
  deletedById      String?
  events           ProposalEvent[]
  letters          IntentLetter[]

  @@index([projectId])
}

model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  /// view | heartbeat | publish | edit | delete | restore | status | letter
  type       String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([proposalId, type])
}

model IntentLetter {
  id                 String    @id @default(cuid())
  proposalId         String
  proposal           Proposal  @relation(fields: [proposalId], references: [id])
  protocolo          String    @unique
  data               Json
  createdAt          DateTime  @default(now())
  /// Minuta da carta (HTML) que a equipe revisa e edita antes de mandar para assinatura
  minutaHtml         String?
  /// revisao | enviada | assinada
  minutaStatus       String    @default("revisao")
  /// Texto travado quando o link de assinatura foi gerado (é o que a pessoa assina)
  minutaFinal        String?
  /// Link de assinatura (/assinar/<token>)
  assinaturaToken    String?   @unique
  linkGeradoEm       DateTime?
  linkEnviadoEm      DateTime?
  /// Confirmação do celular: código de 6 dígitos (guardado com hash) e a sessão aberta depois de confirmar
  codigoHash         String?
  codigoExpira       DateTime?
  codigoEnvios       Int       @default(0)
  codigoTentativas   Int       @default(0)
  telefoneConfirmado String?
  sessaoHash         String?
  sessaoExpira       DateTime?
  /// Documento na Autentique (assinatura eletrônica) e a situação de cada pessoa que assina:
  /// [{ papel, nome, publicId, link, vistoEm, assinadoEm, recusadoEm, motivo }]
  autentiqueId       String?   @unique
  assinaturas        Json?
  /// Carta assinada por todos (PDF da Autentique, com a página de verificação)
  assinadaEm         DateTime?
  pdfAssinado        Bytes?
  pdfAssinadoNome    String?
  assinante          String?

  @@index([proposalId])
}

/// Banco de imagens: fotos e logos usados nas propostas.
model Asset {
  id        String    @id @default(cuid())
  name      String
  mime      String
  width     Int?
  height    Int?
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

/// Documento guardado na pasta do loteamento (vindo do WhatsApp ou enviado no portal)
model ProjectDocument {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  /// documento de uma área da Captação que ainda não virou loteamento (pedido 20/11/2026)
  areaId     String?
  /// matricula | car | certidao | iptu | contrato | planta | procuracao | foto | proposta | obra | venda | outro
  tipo       String    @default("outro")
  /// Etapa do processo: prospeccao | proposta | parceria | aprovacao | obras | vendas (vazio = pela pasta)
  fase       String?
  titulo     String
  resumo     String?
  dados      Json?
  fileName   String
  mime       String
  size       Int
  data       Bytes
  /// whatsapp | portal
  origem     String    @default("whatsapp")
  enviadoPor String?
  grupo      String?
  messageId  String?   @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([projectId, tipo])
}

/// Grupo de WhatsApp que o robô acompanha
model WaGroup {
  id                String    @id @default(cuid())
  jid               String    @unique
  name              String
  /// controle = o robô age neste grupo; inativo = ignorado (só os grupos cadastrados aqui são atendidos)
  papel             String    @default("controle")
  projectId         String?
  /// último loteamento citado na conversa (para saber de quem é o próximo documento)
  contextoProjectId String?
  contextoAt        DateTime?
  /// última área da Captação citada no grupo (pedido 20/11/2026: "manda documento dele" depois de falar de Sorocaba)
  contextoAreaId    String?
  contextoAreaAt    DateTime?
  /// Para que serve o grupo (pedido 19/11/2026): avisos | central | estudos | projeto (vazio = só documentos, como antes)
  funcao            String?
  createdAt         DateTime  @default(now())
}

/// Calendário da pessoa (parecido com o Calendly): horários livres, duração da reunião,
/// link público para agendar (/agendar/<slug>) e a conta do Google Agenda conectada
model AgendaConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  slug          String   @unique
  titulo        String   @default("Reunião com a JBL")
  descricao     String?
  duracaoMin    Int      @default(30)
  /// antecedência mínima para agendar pelo link (horas)
  antecedenciaH Int      @default(2)
  /// até quantos dias à frente o link mostra horários
  diasFrente    Int      @default(30)
  /// { "1": [["09:00","12:00"],["13:00","18:00"]], ... } (0 = domingo)
  horarios      Json
  local         String?
  googleEmail   String?
  googleRefresh String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Compromisso da agenda: pessoal (só a pessoa) ou reunião com um convidado (avisado por e-mail e SMS)
model Compromisso {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  /// pessoal | reuniao
  tipo           String    @default("reuniao")
  titulo         String
  descricao      String?
  local          String?
  inicio         DateTime
  fim            DateTime
  convidadoNome  String?
  convidadoEmail String?
  convidadoTel   String?
  /// interno (criado na tela) | link (agendado pelo convidado no link público)
  origem         String    @default("interno")
  /// marcado | cancelado
  status         String    @default("marcado")
  /// token do link de cancelamento enviado ao convidado
  cancelToken    String    @unique
  /// SMS de lembrete (1 hora antes) agendado no Twilio
  smsId          String?
  smsErro        String?
  emailErro      String?
  /// Avisos no grupo de WhatsApp de monitoramento: marcada, 1 dia antes e 1 hora antes (vazio = ainda não saiu)
  waMarcadoEm    DateTime?
  waDiaEm        DateTime?
  waHoraEm       DateTime?
  waErro         String?
  createdAt      DateTime  @default(now())

  @@index([userId, inicio])
}

/// Página de apresentação de custos (ex.: Chácaras Primavera), fora da plataforma: o rascunho é editado em
/// /apresentacao/editar/<slug> e o link compartilhado (/apresentacao/<token>) mostra a versão publicada.
model Apresentacao {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// Números da aba "CUSTOS" da planilha (lidos do arquivo, sem recalcular)
  dados       Json
  /// Textos alterados à mão: { chave: texto }
  textos      Json      @default("{}")
  /// Aparência de cada texto: { chave: { fonte, tamanho, negrito, cor, fundo } }
  formatos    Json      @default("{}")
  /// Aparência geral: fonte, cores, logo
  estilo      Json      @default("{}")
  /// Cópia de dados, textos, formatos e estilo feita em "Gerar link" (é o que o link mostra)
  publicado   Json?
  publicadoEm DateTime?
  token       String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Senhas erradas no login, por e-mail e IP: depois de várias seguidas, espera um tempo (contra adivinhação)
model LoginTentativa {
  chave  String   @id
  falhas Int      @default(0)
  desde  DateTime @default(now())
}

/// Área em captação (pedido 19/11/2026): o card do funil "Cidade · dono", do KMZ ao contrato. Quando vira
/// loteamento, ganha um Project (projectId) e as propostas seguem o fluxo de sempre.
model Area {
  id                String         @id @default(cuid())
  nome              String         @default("")
  cidade            String
  uf                String         @default("SP")
  dono              String?
  corretor          String?
  /// hectares (do KMZ ou digitado)
  hectares          Float?
  /// captacao | previabilidade | reuniao | proposta | estudo30 | contrato
  etapa             String         @default("captacao")
  /// ativa | geladeira | descartada
  situacao          String         @default("ativa")
  /// descarte e geladeira com motivo (pedido 20/11/2026); ficam guardados mesmo depois de reativar
  motivoDescarte    String?
  descartadaEm      DateTime?
  motivoGeladeira   String?
  geladeiraEm       DateTime?
  geladeiraAte      DateTime?
  /// aviso de "faltam 5 dias" já mandado no grupo
  geladeiraAvisoEm  DateTime?
  /// [[lon, lat], ...] lido do KML/KMZ
  poligono          Json?
  /// respostas do checklist: [{ secao, pergunta, resposta, fonte, ref, em }]
  checklist         Json           @default("[]")
  /// { "<nome do documento>": "ok" | "pedido" | "falta" }
  documentos        Json           @default("{}")
  /// hipóteses do estudo de 30 dias: [{ texto, origem, prova, status }]
  hipoteses         Json           @default("[]")
  conclusao         String?
  /// link do relatório do raio-x (Estudo 1)
  relatorio         String?
  /// Estudo 1 (terreno): semáforo, % aproveitável, lotes, zona, alertas, estratégia, região (pedido 19/11/2026)
  estudo1           Json           @default("{}")
  /// Estudo 2 (mercadológico de concorrentes): concorrentes, revenda, encaixe, produto, prévia financeira, veredito
  estudo2           Json           @default("{}")
  /// custos preliminares: [{ item, valor, base, status }]
  custos            Json           @default("[]")
  /// pessoas do projeto: [{ nome, papel, email, telefone }]
  pessoas           Json           @default("[]")
  /// reunião marcada pela área (compromisso do calendário)
  reuniaoId         String?
  /// link público do estudo para parceiros (/estudo/<token>); vazio = sem link (pedido 19/11/2026)
  estudoToken       String?        @unique
  estudoLinkEm      DateTime?
  /// raio-x completo (blocos de texto, tabelas e imagens) mostrado no link do parceiro; ver src/lib/relatorio.ts
  relatorioCompleto Json?
  /// Estudo 2 completo (mercadológico de concorrentes), no mesmo formato; mostrado depois do raio-x
  relatorioMercado  Json?
  projectId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  conversas         AreaConversa[]
  mensagens         AreaMensagem[]

  @@index([situacao, etapa])
}

/// Conversa de WhatsApp ligada à área (proprietário, corretor, fonte de mercado...). Com "nutrir",
/// as mensagens novas entram no checklist da área.
model AreaConversa {
  id        String   @id @default(cuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  nome      String
  /// só dígitos, com DDI (5511...)
  telefone  String
  /// proprietario | corretor_proprietario | fonte_mercado | tecnico | outro
  papel     String   @default("proprietario")
  nutrir    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([areaId, telefone])
  @@index([telefone])
}

/// Mensagem das conversas ligadas a uma área (recebidas com "nutrir" e enviadas pela tela): o chat da Captação
model AreaMensagem {
  id        String   @id @default(cuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  telefone  String
  nome      String
  deMim     Boolean  @default(false)
  texto     String
  quando    DateTime @default(now())
  messageId String?

  @@index([areaId, quando])
  @@index([telefone, quando])
}

/// Biblioteca de cidades: leis e mapa vigentes por cidade, com a data da conferência e o alerta (pedido 19/11/2026)
model Cidade {
  id          String    @id @default(cuid())
  nome        String
  uf          String
  leis        String
  mapa        String?
  conferidoEm DateTime?
  alerta      String?
  notas       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([nome, uf])
}

/// Mensagens que o sistema mandou pelo WhatsApp: serve para o limite de envio (pedido 20/11/2026: no máximo 2 a cada
/// 15 minutos, para o número não ser bloqueado)
model WaEnvio {
  id  String   @id @default(cuid())
  jid String
  em  DateTime @default(now())
  /// digitada pelo Fernando na tela de Conversas: limite próprio (pedido 20/11/2026)
  manual Boolean @default(false)

  @@index([em])
}

/// Mensagem do sistema que passou do limite de envio (pedido 22/11/2026): espera a vez e sai na próxima vaga
model MensagemEspera {
  id        String    @id @default(cuid())
  jid       String
  texto     String
  createdAt DateTime  @default(now())
  enviadoEm DateTime?

  @@index([enviadoEm, createdAt])
}

/// Lembrete pedido no WhatsApp ("me lembra amanhã às 9h de ligar pro Pedro"), pedido 20/11/2026. Sai no grupo
/// em que foi pedido, pela rotina de 10 em 10 minutos; enviadoEm vazio = ainda não saiu.
model Lembrete {
  id        String    @id @default(cuid())
  texto     String
  quando    DateTime
  grupoJid  String
  pedidoPor String?
  enviadoEm DateTime?
  createdAt DateTime  @default(now())

  @@index([enviadoEm, quando])
}

/// Rotinas que saem uma vez por dia (ex.: "resumo-2026-11-21"): a chave existe = já saiu
model WaRotina {
  chave String   @id
  em    DateTime @default(now())
}

/// Pedido ao Claude da VPS pelo grupo JBL - Claude (pedido 20/11/2026): pesquisas e perguntas, pela assinatura.
/// O Claude da VPS busca a fila, faz e devolve; o Facilita manda a resposta no grupo.
model ComandoClaude {
  id          String    @id @default(cuid())
  texto       String
  grupoJid    String
  autor       String?
  /// pesquisa (pergunta livre) | estudo (Viabilidade Legal da área) | mercado (Viabilidade Mercadológica)
  tipo        String    @default("pesquisa")
  areaId      String?
  /// fila | rodando | feito | erro
  status      String    @default("fila")
  resposta    String?
  createdAt   DateTime  @default(now())
  iniciadoEm  DateTime?
  terminadoEm DateTime?
  /// resposta já mandada no grupo (vazio com status feito = tenta de novo na rotina, por causa do limite)
  enviadoEm   DateTime?
  /// andamento do estudo informado pela VPS (pedido 22/11/2026): 0 a 100 e a fase ("Lendo as leis")
  progresso   Int?
  fase        String?

  @@index([status, createdAt])
}

/// KMZ que alguém mandou no particular (pedido 20/11/2026): o sistema só guarda, sem responder nem criar área.
/// Quando o Fernando encaminha o mesmo KMZ no Central, a área nasce com o nome e o telefone de quem mandou.
model KmzRecebido {
  id        String   @id @default(cuid())
  telefone  String
  /// nome achado nos cadastros (conversa, proposta, carta), senão o nome do WhatsApp, senão vazio
  nome      String?
  fileName  String
  poligono  Json
  /// impressão digital do polígono (para reconhecer o mesmo KMZ encaminhado)
  hash      String
  hectares  Float?
  cidade    String?
  uf        String?
  messageId String   @unique
  areaId    String?
  createdAt DateTime @default(now())

  @@index([hash])
}

/// Contato de WhatsApp particular (pedido 20/11/2026): o Claude da VPS lê a conversa e diz se é sobre terra.
/// Só os de terra aparecem em Conversas; os "fora" não guardam mensagem nenhuma.
model ContatoTerra {
  id             String    @id @default(cuid())
  /// só dígitos, com DDI (5511...)
  telefone       String    @unique
  nome           String?
  /// pendente (esperando o Claude) | terra | fora
  situacao       String    @default("pendente")
  /// proprietario | corretor | outro
  papel          String?
  resumo         String?
  ultimaEm       DateTime  @default(now())
  classificadoEm DateTime?
  createdAt      DateTime  @default(now())

  @@index([situacao, ultimaEm])
}

/// Mensagens das conversas particulares de contatos pendentes ou de terra (ida e volta)
model MensagemParticular {
  id            String   @id @default(cuid())
  telefone      String
  deMim         Boolean  @default(false)
  texto         String
  quando        DateTime
  messageId     String   @unique
  /// áudio esperando a transcrição na VPS (pedido 20/11/2026)
  audioPendente Boolean  @default(false)

  @@index([telefone, quando])
  @@index([audioPendente])
}
