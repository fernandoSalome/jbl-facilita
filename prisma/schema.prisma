generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  proposals    Proposal[] @relation("createdBy")
}

/// Um projeto é um loteamento (a "subconta"). Tudo do loteamento pendura aqui:
/// propostas hoje; documentos, licenças, tarefas e o grupo de WhatsApp depois.
model Project {
  id          String     @id @default(cuid())
  name        String
  tipo        String     @default("Loteamento aberto")
  municipio   String
  uf          String     @default("SP")
  matricula   String?
  areaTotal   Float
  /// URL pública (/demo/...) ou data URL da foto aérea
  aerialImage String?
  /// prospeccao | proposta | parceria | aprovacao | obras | vendas | carteira | arquivado
  fase        String     @default("prospeccao")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  proposals   Proposal[]
  documents   ProjectDocument[]
}

model Template {
  id             String     @id @default(cuid())
  /// Chave do componente que renderiza o template ("jbl-padrao")
  key            String?
  name           String
  description    String?
  /// ativo | em_preparacao
  status         String     @default("ativo")
  sourceFileName String?
  sourceFile     Bytes?
  createdAt      DateTime   @default(now())
  deletedAt      DateTime?
  proposals      Proposal[]
  versions       FormatoVersion[]
}

/// Conteúdo de um formato (loteamento aberto, condomínio...) dentro de um template:
/// listas de obras e benfeitorias, padrões e textos. Cada "Salvar" do template cria
/// uma versão nova. "Só nas próximas" deixa as propostas antigas na versão anterior.
model FormatoVersion {
  id          String     @id @default(cuid())
  templateId  String
  template    Template   @relation(fields: [templateId], references: [id])
  formato     String
  content     Json
  createdById String?
  createdAt   DateTime   @default(now())
  proposals   Proposal[]

  @@index([templateId, formato])
}

model Proposal {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  templateId    String
  template      Template        @relation(fields: [templateId], references: [id])
  /// loteamento_aberto | condominio_urbano | chacreamento_aberto | chacreamento_condominio
  formato       String          @default("loteamento_aberto")
  /// Versão do formato que a proposta usa (texto, listas). Ajustes da proposta ficam em overrides.
  formatoVersionId String?
  formatoVersion   FormatoVersion? @relation(fields: [formatoVersionId], references: [id])
  name          String
  ownerName     String
  ownerPhone    String?
  /// Entradas do estudo (StudyInputs). Os resultados são recalculados a partir delas.
  inputs        Json
  /// cartaIntencao, validadeDias, corretor...
  options       Json            @default("{}")
  /// Valores e textos alterados à mão na proposta: { chave: texto }
  overrides     Json            @default("{}")
  /// rascunho | enviada | aberta | carta_recebida | negociacao | aceita | recusada
  status        String          @default("rascunho")
  publicToken   String          @unique
  publishedAt   DateTime?
  expiresAt     DateTime?
  /// PDF gerado da proposta: arquivo, número de páginas e a "assinatura" do conteúdo que o gerou
  pdfData       Bytes?
  pdfPages      Int?
  pdfKey        String?
  viewCount     Int             @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  createdById   String?
  createdBy     User?           @relation("createdBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  /// Exclusão lógica: nunca apaga, só esconde. Admin pode reativar.
  deletedAt     DateTime?
  deletedById   String?
  events        ProposalEvent[]
  letters       IntentLetter[]

  @@index([projectId])
}

model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  /// view | heartbeat | publish | edit | delete | restore | status | letter
  type       String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([proposalId, type])
}

model IntentLetter {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  protocolo  String   @unique
  data       Json
  createdAt  DateTime @default(now())
}

/// Banco de imagens: fotos e logos usados nas propostas.
model Asset {
  id        String    @id @default(cuid())
  name      String
  mime      String
  width     Int?
  height    Int?
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

/// Documento guardado na pasta do loteamento (vindo do WhatsApp ou enviado no portal)
model ProjectDocument {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  /// matricula | car | certidao | iptu | contrato | planta | procuracao | foto | proposta | obra | venda | outro
  tipo       String    @default("outro")
  /// Etapa do processo: prospeccao | proposta | parceria | aprovacao | obras | vendas (vazio = pela pasta)
  fase       String?
  titulo     String
  resumo     String?
  dados      Json?
  fileName   String
  mime       String
  size       Int
  data       Bytes
  /// whatsapp | portal
  origem     String    @default("whatsapp")
  enviadoPor String?
  grupo      String?
  messageId  String?   @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([projectId, tipo])
}

/// Grupo de WhatsApp que o robô acompanha
model WaGroup {
  id          String   @id @default(cuid())
  jid         String   @unique
  name        String
  /// controle = o robô age neste grupo; inativo = ignorado (só os grupos cadastrados aqui são atendidos)
  papel       String   @default("controle")
  projectId   String?
  /// último loteamento citado na conversa (para saber de quem é o próximo documento)
  contextoProjectId String?
  contextoAt  DateTime?
  createdAt   DateTime @default(now())
}
