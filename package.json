{
  "name": "jbl-facilita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && DATABASE_URL=\"$DIRECT_URL\" prisma migrate deploy && DATABASE_URL=\"$DIRECT_URL\" tsx prisma/seed.ts && next build",
    "start": "prisma migrate deploy && tsx prisma/seed.ts && next start -p ${PORT:-3000}",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sparticuz/chromium": "130.0.0",
    "@vercel/functions": "1.5.2",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "14.2.35",
    "playwright-core": "1.48.2",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
